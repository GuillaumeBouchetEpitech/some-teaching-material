digraph {

  bgcolor="#aaaaaa"

  compound=true;

  node [
    shape="box"
    style=filled
    fontcolor="#eeeeee"
    fillcolor="#666644"
    margin="0.2"
  ]

  edge [
    fontcolor="#ffffff"
    color="#aaaaaa"
    penwidth=6.0
    len=1.0
    minlen=0.0
  ]

  subgraph modular_rag {
    label = "Modular RAG"
    fontcolor="#ffffff"
    bgcolor="#333333"
    cluster=true
    // lheight=5.0
    margin="30.0"

    research [label=< <b>User requested</b><br/><br/>- Research<br align="left"/>- Debugging<br align="left"/>- etc.<br align="left"/>> shape="box" fillcolor="#444444"]

    subgraph main_loop {
      label = "Main Loop"
      fontcolor="#ffffff"
      bgcolor="#555555"
      style="filled,rounded"
      cluster=true

      node [style="filled,rounded"]
      node [fillcolor="#664466"]

      step1 [label=<<b>Step 1</b>
<br align="left"/>
<br align="left"/>- is just a <b>normal research</b>
<br align="left"/>- use up to 3 researcher subagents
<br align="left"/>>]

      step2 [label=<<b>Step 2</b>
<br align="left"/>
<br align="left"/>- is a <b>counter research</b>
<br align="left"/>    - must challenge <b>Step 1</b>'s result
<br align="left"/>    - an "adversarial" type of approach
<br align="left"/>- use up to 3 researcher subagents
<br align="left"/>>]

      node [fillcolor="#114488"]

      step3 [label=<<b>Step 3</b>
<br align="left"/>
<br align="left"/>- judge the results
<br align="left"/>- determine confidence
<br align="left"/>>]

      node [style="filled"]

      node [margin="0.0" width="1.5" height="1.5"]

      step3_1 [label="confidence\nscore?\n" shape="diamond" fillcolor="#666600"]
      step3_2 [label="can retry?\n(max 5)\n" shape="diamond" fillcolor="#664422"]

      node [margin="0.0" width="0.0" height="0.0"]
    }

    // subgraph results {
    //   label = "Final Result"
    //   fontcolor="#ffffff"
    //   bgcolor="#555555"
    //   style="filled,rounded"
    //   cluster=true

      node [style="filled,rounded"]

      final_result [label=<
        <table border="0" cellpadding="4">

          <tr>
            <td colspan="1"></td>
            <td PORT="low_confidence" bgcolor="#440000" border="1" align="center" colspan="1">Low Confidence<br/>Research Final Report</td>
            <td PORT="high_confidence" bgcolor="#004400" border="1" align="center" colspan="1">High Confidence<br/>Research Final Report</td>
          </tr>

          <tr>
            <td bgcolor="#555555" border="1" align="left" colspan="1" rowspan="2">Chapter-1</td>
             <td bgcolor="#555522" border="1" align="left" colspan="2">
- Short summary (as in: <font color="orange">"TL;DR"</font>).<br align="left"/>
- Must clearly share the general confidence level<br align="left"/>
  of the entire research.<br align="left"/></td>
         </tr>

          <tr>
            <td bgcolor="#664444" border="1" align="left" colspan="1">
- Must say: <font color="orange">"I don't know"</font>.<br align="left"/>
    - By saying it <font color="green">the <b>risks of</b></font><br align="left"/>
      <font color="green"><b>hallucination</b> will be</font><br align="left"/>
      <font color="green">heavily <b>reduced</b> (<b>or</b></font><br align="left"/>
      <font color="green">sometimes <b>cancelled</b>)</font>.<br align="left"/>
</td>
            <td bgcolor="#446644" border="1" align="left" colspan="1">...</td>
          </tr>

          <tr>
            <td bgcolor="#555555" border="1" align="left" colspan="1">Chapter-2</td>
            <td bgcolor="#555522" border="1" align="left" colspan="2">
- What was done.<br align="left"/>
    - Which subagents where used and why.<br align="left"/>
    - Any kind of failures (tools, etc.) will appear here.</td>
          </tr>

          <tr>
            <td bgcolor="#555555" border="1" align="left" colspan="1" rowspan="2">Chapter-3</td>
            <td bgcolor="#555522" border="1" align="left" colspan="2">
- The complete research results.<br align="left"/>
- The question(s) asked are answered one<br align="left"/>
  by one, sub-chapter by sub-chapter.<br align="left"/>
    - One sub-chapter for each questions asked.<br align="left"/>
    - each sub-chapter must share its "confidence level".<br align="left"/></td>
          </tr>

          <tr>
            <td bgcolor="#664444" border="1" align="left" colspan="1">
- Must repeat: <font color="orange">"I don't know"</font>.<br align="left"/>
  per sub-chapter(s) and answer<br align="left"/>
  <font color="orange">"Why the low confidence?"</font>.<br align="left"/></td>
            <td bgcolor="#446644" border="1" align="left" colspan="1">...</td>
          </tr>

          <tr>
            <td bgcolor="#555555" border="1" align="left" colspan="1">Chapter-4</td>
            <td bgcolor="#555522" border="1" align="left" colspan="2">- The list of used sources/references.</td>
          </tr>

        </table>>
        margin="0.3" fillcolor="#666666"]


      node [margin="0.15"]
    // }

    node [style="filled"]
    node [fillcolor="#444444"]

    subgraph cluster_subagents {

      label = "All Sub-Agents"

      all_subagents [label=<
        <table border="0" cellpadding="4">
        <tr><td PORT="leader" bgcolor="#660000" colspan="3"><b>Research Team Leader</b><br/>(is in fact running the Modular RAG entire logic)</td></tr>

        <tr><td PORT="worker" bgcolor="#552255" rowspan="6" colspan="1"><b>Researchers</b><br/><br/>(Step 1 and 2<br/>uses that)</td></tr>
        <tr><td bgcolor="#440044"  border="1" align="left" colspan="1">Docs</td><td bgcolor="#440044"  border="1" align="left" colspan="1">Confluence, internal wiki, etc.</td></tr>
        <tr><td bgcolor="#552255"  border="1" align="left" colspan="1">Source Code</td><td bgcolor="#552255"  border="1" align="left" colspan="1">graphify, sourcebot, github, etc.</td></tr>
        <tr><td bgcolor="#440044"  border="1" align="left" colspan="1">Proj. Manager</td><td bgcolor="#440044"  border="1" align="left" colspan="1">Jira, Linear, etc.</td></tr>
        <tr><td bgcolor="#552255"  border="1" align="left" colspan="1">Loggers</td><td bgcolor="#552255"  border="1" align="left" colspan="1">Grafana, Datadog, etc.</td></tr>
        <tr><td bgcolor="#440044"  border="1" align="left" colspan="1">Cloud</td><td bgcolor="#440044"  border="1" align="left" colspan="1">AWS, ArgoCD, kubectl, etc.</td></tr>

        <tr><td PORT="critic" bgcolor="#114488" colspan="3"><b>Research Results Critic</b><br/>(Step 3 uses that)</td></tr>
        </table>>
        margin="0.3"]

    }

  }

  research -> step1 [color="#888888" minlen=1.0]

  edge  [color="#ff88ff"]
  step1 -> step2 [minlen=0.0]
  step2 -> step3 [minlen=0.0]
  edge  [color="#114488"]
  step3 -> step3_1 [minlen=1.0]
  step3_1 -> step3_2 [label=" Low\nconfidence\nscore" fontcolor="#ffff00" color="#888800" minlen=0.0]
  step1 -> step3_2 [label="Can retry\n" fontcolor="#ffaa44" color="#cc6633" dir="back" style="dashed" penwidth=6]

  step3_2 -> final_result:low_confidence [label=" No more\nretries left\n" fontcolor="#ff8888" color="#882222" minlen=1.0]
  step3_1 -> final_result:high_confidence [label="High\nconfidence\nscore" fontcolor="#00ff00" color="#008800" minlen=1.0]


  edge [
    len=0.0
    minlen=0.0
  ]

  // research -> all_subagents:leader [label="" color="#880000" fontcolor="#ff8888"]
  // step1 -> all_subagents:worker [label="" color="#008800" fontcolor="#88ff88"]
  // step2 -> all_subagents:worker [label="" color="#008800" fontcolor="#88ff88"]
  // step3 -> all_subagents:critic [label="" color="#114488" fontcolor="#66aaff"]
  step3 -> all_subagents:critic [style="invis"]

}
